{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@shopify-ai-blog/ai": ["../../packages/ai/src"],
      "@shopify-ai-blog/content-engine": ["../../packages/content-engine/src"],
      "@shopify-ai-blog/db": ["../../packages/db/src"],
      "@shopify-ai-blog/i18n": ["../../packages/i18n/src"],
      "@shopify-ai-blog/shared": ["../../packages/shared/src"],
      "@shopify-ai-blog/shopify": ["../../packages/shopify/src"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
